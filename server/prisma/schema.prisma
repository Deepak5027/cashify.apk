generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth / Auth models (Prisma adapter)
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  phone           String?
  location        String?
  currency        String?
  timezone        String?
  lastLogin       DateTime?
  lastLoginDevice String?
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models inferred from repository usage
model Transaction {
  id                Int       @id @default(autoincrement())
  userId            String
  amount            Float
  description       String?
  category          String?
  type              String    @default("expense")
  paymentMode       String?   @default("Cash")
  isRecurring       Boolean   @default(false)
  recurringPeriod   String?
  nextRecurringDate DateTime?
  date              DateTime  @default(now())
  riskScore         Float     @default(0)
  riskReason        String    @default("Normal transaction")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Budget {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  limit     Float
  period    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  target    Float
  saved     Float   @default(0)
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Investment {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  amount    Float
  dueDate   DateTime?
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Receipt {
  id        Int      @id @default(autoincrement())
  userId    String
  total     Float
  merchant  String?
  date      DateTime @default(now())
  items     ReceiptItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceiptItem {
  id         Int     @id @default(autoincrement())
  receiptId  Int
  name       String
  price      Float
  quantity   Int     @default(1)
  receipt    Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    String
  action    String
  title     String
  details   String?
  type      String   @default("info")
  createdAt DateTime @default(now())
}

model KvStore {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
}

model VirtualCard {
  id              Int      @id @default(autoincrement())
  userId          String
  cardName        String   @default("AiFinancify Virtual Card")
  cardType        String   @default("Virtual Debit")
  cardNetwork     String   @default("VISA")
  bankName        String   @default("AiFinancify Bank")
  cardNumber      String   @default("•••• •••• •••• 8821")
  cardHolder      String   @default("AIFINANCIFY MEMBER")
  expiryDate      String   @default("08/29")
  cvv             String   @default("842")
  spendingLimit   Float    @default(50000)
  currentSpend    Float    @default(0)
  isFrozen        Boolean  @default(false)
  tapToPayEnabled Boolean  @default(true)
  internationalTx Boolean  @default(false)
  cardColor       String   @default("indigo")
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id               Int       @id @default(autoincrement())
  userId           String
  name             String
  amount           Float
  billingCycle     String    @default("monthly")
  category         String    @default("Entertainment")
  nextBillingDate  DateTime
  reminderDays     Int       @default(3)
  isActive         Boolean   @default(true)
  color            String?   @default("#6366F1")
  iconName         String?   @default("subscriptions")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Invoice {
  id          Int           @id @default(autoincrement())
  userId      String
  invoiceNo   String
  clientName  String
  clientEmail String?
  clientPhone String?
  upiId       String?       @default("deepak@okaxis")
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  status      String        @default("unpaid")
  taxRate     Float         @default(18.0)
  notes       String?
  items       InvoiceItem[]
  totalAmount Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

